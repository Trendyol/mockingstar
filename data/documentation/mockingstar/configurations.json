{"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"Mocking Star provides a comprehensive set of configuration options to customize how it handles different aspects of request mocking. These configurations allow you to fine-tune the behavior of Mocking Star to match your project’s specific requirements.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Configuration Types","anchor":"Configuration-Types","type":"heading"},{"inlineContent":[{"text":"Mocking Star offers several types of configurations:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"General Configurations"}]},{"type":"text","text":": Basic settings that affect the overall behavior of Mocking Star"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Path Configurations"}]},{"type":"text","text":": Control how request paths are matched and processed"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Query Configurations"}]},{"type":"text","text":": Manage how query parameters are handled in requests"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Header Configurations"}]},{"type":"text","text":": Configure how HTTP headers are processed"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Filters"}]},{"type":"text","text":": Define rules for filtering and managing mocks"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"Quick Start","anchor":"Quick-Start","type":"heading"},{"inlineContent":[{"text":"To get started with configurations:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Open Mocking Star"}],"type":"paragraph"}]},{"c