{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.trendyol.mocking-star\/documentation\/MockingStar\/MockingStarCLI"},"metadata":{"color":{"standardColorIdentifier":"gray"},"roleHeading":"Article","title":"🛠️ Mocking Star CLI","modules":[{"name":"MockingStar"}],"role":"article","images":[{"identifier":"terminal_icon.png","type":"icon"}]},"abstract":[{"text":"Run CLI version of Mocking Star","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"You can use all operations independently of the UI with the Mocking Star CLI. Features such as listing and editing mocks are not available in the CLI version. CLI version is developed specifically for use in CI\/CD pipelines. CLI version has ","type":"text"},{"inlineContent":[{"text":"Linux","type":"text"}],"type":"strong"},{"text":" and ","type":"text"},{"inlineContent":[{"text":"macOS","type":"text"}],"type":"strong"},{"text":" support.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"CLI Usage","type":"text"}],"type":"strong"}]},{"syntax":null,"code":["YusufOzgul@macOS Debug % .\/MockingStar help start","OVERVIEW: Start mock server","","USAGE: .\/MockingStar start [--logs-folder <logs-folder>] [--port <port>] [--trace-export <trace-export>] <folder>","","ARGUMENTS:","    <folder>                Mocks folder path","","OPTIONS:","    -l, --logs-folder <logs-folder>","                            Logs folder","    -p, --port <port>       HTTP Server Port (default: 8008)","    -t, --trace-export <trace-export>","                            Export Mock Trace JSONL to this file or directory (default: .\/MockingStarTrace.json)","    -h, --help              Show help information."],"type":"codeListing"},{"name":"Tip","type":"aside","style":"tip","content":[{"inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"In CI\/CD environment, you can prevent the use of unmocked data.","type":"text"},{"text":" ","type":"text"},{"text":"This ensures that in the CI\/CD environment, requests for unmocked data will not be sent to the real server.","type":"text"},{"text":" ","type":"text"},{"text":"To achieve this, you need to add the header ","type":"text"},{"code":"disableLiveEnvironment=true","type":"codeVoice"},{"text":" to your requests.","type":"text"}],"type":"paragraph"}]},{"style":"tip","name":"Tip","content":[{"inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"Mocking Star allows multiple applications to use the same mock folder. For example, if you are running your application with multiple instances\/simulators\/emulators, a single Mocking Star instance is sufficient."}],"type":"paragraph"}],"type":"aside"},{"name":"Tip","type":"aside","style":"tip","content":[{"inlineContent":[{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"Every request is exported as a Mock Trace entry (URL, method, response type, duration in seconds) to a JSONL file."},{"type":"text","text":" "},{"type":"text","text":"By default this is "},{"type":"codeVoice","code":".\/MockingStarTrace.json"},{"type":"text","text":" in the current working directory."},{"type":"text","text":" "},{"type":"text","text":"Use "},{"code":"--trace-export","type":"codeVoice"},{"type":"text","text":" to override the path."},{"type":"text","text":" "},{"code":"--logs-folder","type":"codeVoice"},{"type":"text","text":" only affects general log files ("},{"code":"MockingStar.log","type":"codeVoice"},{"type":"text","text":"), not the Mock Trace export."}],"type":"paragraph"}]},{"style":"warning","type":"aside","name":"Warning","content":[{"inlineContent":[{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"Linux CLI version does not support Plugins due to JavaScriptCore not available on Linux.","type":"text"}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"CLI Mock Usage Analysis"}],"type":"strong"}]},{"code":["YusufOzgul@macOS Debug % .\/MockingStar help analyze-usage","OVERVIEW: Analyze previous mock usage from logs file","","USAGE: .\/MockingStar analyze-usage [--logs-folder <logs-folder>]","","OPTIONS:","    -l, --logs-folder <logs-folder>","                            Logs folder","    -h, --help              Show help information."],"type":"codeListing","syntax":null}]}],"variants":[{"paths":["\/documentation\/mockingstar\/mockingstarcli"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/com.trendyol.mocking-star\/documentation\/MockingStar"]]},"kind":"article","references":{"doc://com.trendyol.mocking-star/documentation/MockingStar":{"abstract":[],"identifier":"doc:\/\/com.trendyol.mocking-star\/documentation\/MockingStar","kind":"symbol","role":"collection","title":"MockingStar","type":"topic","url":"\/documentation\/mockingstar"},"terminal_icon.png":{"identifier":"terminal_icon.png","alt":null,"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/com.trendyol.mocking-star\/terminal_icon.png"}]}}}